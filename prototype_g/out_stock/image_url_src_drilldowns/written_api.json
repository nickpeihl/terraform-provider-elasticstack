{
  "description": "Dashboard with typed image panel (URL src, mixed drilldowns)",
  "options": {},
  "panels": [
    {
      "config": {
        "description": "Image panel description",
        "drilldowns": [
          {
            "dashboard_id": "spike0-target-dashboard",
            "label": "Open dashboard",
            "trigger": "on_click_image",
            "type": "dashboard_drilldown"
          },
          {
            "label": "External link",
            "trigger": "on_click_image",
            "type": "url_drilldown",
            "url": "https://example.com/details/{{context.panel.title}}"
          }
        ],
        "hide_border": true,
        "hide_title": false,
        "image_config": {
          "alt_text": "Logo",
          "background_color": "#111111",
          "object_fit": "cover",
          "src": {
            "type": "url",
            "url": "https://example.com/logo.png"
          }
        },
        "title": "Image panel title"
      },
      "grid": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "type": "image"
    }
  ],
  "query": {
    "expression": "",
    "language": "kql"
  },
  "refresh_interval": {
    "pause": true,
    "value": 0
  },
  "time_range": {
    "from": "now-15m",
    "to": "now"
  },
  "title": "Image url src"
}